# Enterprise Conversational Workflow Platform Configuration

ENVIRONMENT=development
DEBUG=true

# Database & Redis Infrastructure
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bsp_whatsapp_enterprise
REDIS_URL=redis://localhost:6379/0

# Security & PII Encryption
SECRET_KEY=dev_insecure_secret_key_replace_in_production_with_strong_entropy_32char
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PII_TOKEN_AES_KEY=0123456789abcdef0123456789abcdef

# -------------------------------------------------------------
# 3-STAGE CASCADING HYBRID NLU STATE CONTROLLERS & GATES
# -------------------------------------------------------------
# Stage 1: Deterministic Trigram & Regex Fast-Path
USE_FAST_PATH=true
FAST_PATH_CONFIDENCE_THRESHOLD=0.90

# Stage 2: Custom Local Classifier (HuggingFace / ONNX)
USE_CUSTOM_MODEL=true
CUSTOM_MODEL_TYPE=open_weight
CUSTOM_MODEL_PATH=models/nigerian_pidgin_intent
CUSTOM_MODEL_CONFIDENCE_THRESHOLD=0.75

# Stage 3: LLM Escalation (Google Gemini 3.7 Flash)
USE_LLM_ESCALATION=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# -------------------------------------------------------------
# EXTERNAL ADAPTER RAILS & MOCK HARNESSES
# -------------------------------------------------------------
# Payment Adapter (Moniepoint MFB / Paystack)
USE_MOCK_PAYMENT_GATEWAY=true
MONIEPOINT_API_KEY=
MONIEPOINT_BASE_URL=https://api.moniepoint.com/v1

# WhatsApp Business Solution Provider (Meta Cloud / Termii)
USE_MOCK_WHATSAPP_BSP=true
WHATSAPP_BSP_PROVIDER=META_CLOUD
META_CLOUD_API_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=enterprise_whatsapp_secret_webhook_token
